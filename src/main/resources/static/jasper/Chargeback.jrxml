		<variableExpression><![CDATA[$F{REVERSAL_AMOUNT} != null ? $F{REVERSAL_AMOUNT} : BigDecimal.ZERO]]></variableExpression>
	</variable>
	<variable name="SUCCESS_TRAN_AMOUNT" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{REVERSAL_REMARKS}.equals("REVERTED") ? $F{REVERSAL_AMOUNT} : 0.0]]></variableExpression>
	</variable>
	<variable name="SUCCESS_TRAN_COUNT" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{REVERSAL_REMARKS}.equals("REVERTED") ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="FAILURE_TRAN_AMOUNT" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{REVERSAL_REMARKS}.equals("PENDING") ? $F{REVERSAL_AMOUNT} : 0.0]]></variableExpression>
	</variable>
	<variable name="FAILURE_TRAN_COUNT" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{REVERSAL_REMARKS}.equals("PENDING") ? 1 : 0]]></variableExpression>
	</variable>
